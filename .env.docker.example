# docker compose 用 環境変数テンプレート。
# cp .env.docker.example .env で作成し値を設定(.env はgitignore)。

# uid暗号鍵(必須・本番)。生成例: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PHI_SECRET_KEY=

# 動作モード。production=PHI_SECRET_KEY 未設定なら起動失敗(fail-closed)
# 開発でゆるく試すなら development
# A-33: 認証は Bearer token(cookie/CSRF 廃止)のため CSRF 許可 origin 設定は無し。
PHI_ENV=production

# エッジ(リバースプロキシ)の信頼段数。nginx 1段なら1。XFFの右からN段剥がし実IPを得る
PHI_TRUSTED_PROXY_HOPS=1

# エッジ公開ポート(ホスト側)
WEB_PORT=8080

# レガシー既定接続先(任意。キャラ別の接続先が無い場合の既定)
PHI_HOST=
PHI_PORT=20000
